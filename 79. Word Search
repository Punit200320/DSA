class Solution {
    int n ,m ,l;
    int[][] directions = {{0,1},{0,-1},{1,0},{-1,0}};
    public boolean find(char[][] board,int i,int j,String word,int idx){
        if(idx >= l)return true;
        if(i < 0 || i >= n || j < 0 || j >= m || board[i][j] != word.charAt(idx))
        return false;

        char temp = board[i][j];
        board[i][j] = '$';

        for(int[] dir : directions){
            int i1 =  i + dir[0];
            int j1 = j + dir[1];

            if(find(board,i1,j1,word,idx + 1)){
                return true;
            }
        }
        board[i][j] = temp;
        return false;
    }
    public boolean exist(char[][] board, String word) {
        n = board.length;
        m = board[0].length;
        l = word.length();
        if(n*m < 1)return false;
        for(int i = 0; i < n; i++){
            for(int j = 0; j < m; j++){
                if(board[i][j] == word.charAt(0) && find(board,i,j,word,0)){
                    return true;
                }
            }
        }

    return false;
    }
}
