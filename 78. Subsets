class Solution {
    public List<List<Integer>> subsets(int[] nums) {
     List<List<Integer>> res = new ArrayList<>();
     gensum(0,nums,new ArrayList<>(), res);
     return res;
    }
    void gensum(int ind, int[] nums, List<Integer> curr, List<List<Integer>> res){
        res.add(new ArrayList<>(curr));
        for(int i = ind; i < nums.length; i++){
            curr.add(nums[i]);
            gensum(i+ 1,nums, curr, res);
            curr.remove(curr.size() - 1);
        }
    }
}



















































