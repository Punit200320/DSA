class Solution {
    int n;
    private Boolean[] t;
    public boolean wordBreak(String s, List<String> wordDict) {
    n = s.length();
    t = new Boolean[n];
    return solve(s,0,wordDict);
    }
    private boolean solve(String s, int idx, List<String> wordDict){
     if(idx == n){
        return true;
     }   
     if (t[idx] != null) {
            return t[idx];
        }

     for(int endind = idx + 1; endind  <= n; endind++){
        String split = s.substring(idx,endind);
        if(wordDict.contains(split) && solve(s, endind, wordDict)){
            return t[idx] = true;
        }
     }
     return t[idx] = false;
    }
}
