class Solution {
    private static int[] di = {+1,0,0,-1};
    private static int[] dj = {0,-1,+1,0};
    public static void solve(int[][] m,int n,int[][] visi,int i, int j , ArrayList<String> ans, String ref){
     if(i == n - 1 && j == n - 1){
         ans.add(ref);
         return;
     }
     String st = "DLRU";
     
     visi[i][j] = 1;
     for(int l =0; l < 4; l++){
        int dc = i + di[l];
        int dd = j + dj[l];
        
        if(dc >= 0 && dd >= 0 && dd <n && dc < n && visi[dc][dd] == 0 && m[dc][dd] == 1){
            
        
        // visi[i][j] = 1;
        solve(m,n,visi,dc,dd,ans,ref + st.charAt(l));
        }
        // visi[i][j] = 0;
     }
     visi[i][j] = 0;
    }
    public ArrayList<String> ratInMaze(int[][] maze) {
        // code here
       int n = maze.length;
       
       ArrayList<String> ans = new ArrayList<>();
       
       int[][] visited = new int[n][n];
       
       String ref = "";
       
       if(maze[0][0] ==1){
           solve(maze,n,visited,0,0,ans,ref);
       }
    //   if(ans.isEmpty()){
    //       ans.add("-1");
    //   }
       
       return ans;
    }
}
