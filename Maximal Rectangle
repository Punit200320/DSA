    public int MAH(int[] height, int n){
        Stack<Integer> st = new Stack<>();
        int i = 0;
        int maxArea = 0;
        int area  = 0;
        while(i < n){
            if(st.isEmpty() || height[i] >= height[st.peek()]){
                st.push(i++);
            }
            else{
                int index = st.pop();
                if(st.isEmpty()){
                    area = height[index] * i;
                }else {
                    area = height[index] *  (i - st.peek() - 1);
                }
                maxArea = Math.max(maxArea,area);
            }
        }
        while(!st.isEmpty()){
            int index = st.pop();
            if(st.isEmpty()){
                area = height[index] * i;
            }else{
                area = height[index] * (i - st.peek() -1);
            }
            maxArea = Math.max(maxArea,area);
        }
        return maxArea;
    }
