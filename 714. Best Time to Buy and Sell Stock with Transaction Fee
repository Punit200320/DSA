class Solution {
    int[][] dp;
    private int maxa(int i ,int buy1,int[] prices,int fee){
    if(i >= prices.length){
        return 0;
    }
    if(dp[i][buy1] != -1){
         return dp[i][buy1];
    }
    int ans = 0;
    if(buy1 == 0){
        int buy = maxa(i + 1, 1,prices,fee) - prices[i];
        int notbuy = maxa(i + 1, 0,prices,fee);
        ans =  Math.max(buy,notbuy);
    }else{
        int sell = maxa(i + 1, 0, prices, fee) + prices[i] - fee;
        int notsell = maxa(i + 1, 1,prices,fee);
        ans = Math.max(sell,notsell);
    }
    return dp[i][buy1] = ans;
    }
    public int maxProfit(int[] prices, int fee) {
    int n = prices.length;
    if(n == 0|| n == 1){
        return 0;
    }
    dp = new int[n +1][2];
    for(int[] row : dp){
        Arrays.fill(row, -1);
    }
    return maxa(0,0,prices,fee);
    }
}
