class Solution {
    int m,n;
    int emptycell;
    int res = 0;
    int[][] directions = {{1,0}, {-1,0},{0,1},{ 0,-1}};
    public void dfs(int[][] grid,int currCount,int i,int j){
        if(i < 0 || j < 0 || i >=m || j >= n || grid[i][j] ==  -1){
            return;
        }
        if(grid[i][j] == 2){
            if(currCount  == emptycell){
                res++;
            }
            return;
        }
         int temp  = grid[i][j];
         grid[i][j] = -1;
         for(int[] dir : directions){
            int newi = i + dir[0];
            int newj = j + dir[1];

            dfs(grid,currCount + 1,newi,newj);
         }
         grid[i][j] = temp;
    }
    public int uniquePathsIII(int[][] grid) {
        m = grid.length;
        n = grid[0].length;
        emptycell = 0;
        res =0;
        int x =0;
        int y = 0;
        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                if(grid[i][j] == 0){
                    emptycell++;
                }
                if(grid[i][j] == 1){
                    x = i;
                    y = j;
                }
            }
        }
        emptycell += 1;
        dfs(grid,0,x,y);
        return res;
    }
}
