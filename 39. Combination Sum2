class Solution {
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> comb = new ArrayList<>();
        gensum(0,candidates,target,comb, new ArrayList<>());
        return comb;
    }
    void gensum(int ind,int[] candidates,int target,List<List<Integer>> comb, List<Integer> curr){

      if(target == 0){
        comb.add(new ArrayList<>(curr));
      }
      if( target < 0 ){
        return;
      }
      for(int i = ind; i < candidates.length; i++){
        curr.add(candidates[i]);
        gensum(i,candidates,target - candidates[i],comb, curr);
        curr.remove(curr.size() - 1);
      }
    }
}























































































