class Solution {
    public Node segregate(Node head) {
    if(head ==  null|| head.next == null){
        return head;
    }
    ArrayList<Integer> arr = new ArrayList<>();
    Node curr = head;
    while( curr != null){
        arr.add(curr.data);
        curr = curr.next;
    }
    Collections.sort(arr);
    
    curr = head;
    for(int i = 0; i < arr.size(); i++){
        curr.data = arr.get(i);
        curr = curr.next;
    }
    return head;
        
    }
}
