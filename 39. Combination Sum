class Solution {
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> comb = new ArrayList<>();
        gensub(0,candidates,new ArrayList<>(),comb,target);
        return comb;
    }
    void gensub(int start,int[] cand,List<Integer> curr,List<List<Integer>> comb,int target){
        if(target == 0){
          comb.add(new ArrayList<>(curr));
        }
        if(target < 0 ){
            return;
        }
        for(int i = start; i < cand.length; i++){
            curr.add(cand[i]);
            gensub(i ,cand,curr,comb,target - cand[i]);
            curr.remove(curr.size() - 1);
        }
    }
}
