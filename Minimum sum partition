class Solution {
    int dp[][];
    int totalsum;
    public int subset(int[] arr, int currsum , int i){
      if(i == arr.length){
          int sub2 = totalsum - currsum;
          return Math.abs(currsum -sub2);
      }
      
      if(dp[i][currsum] != -1){
          return dp[i][currsum];
          }
      
      int take = subset(arr,currsum + arr[i], i+ 1);
      int skip = subset(arr,currsum, i+ 1);
      
      return  dp[i][currsum] = Math.min(take,skip);
    }
    public int minDifference(int arr[]) {
        // code here
         int n = arr.length;
         
        int sum = 0;
        for(int i = 0; i < n; i++){
             totalsum = totalsum + arr[i];
        }
        
        if(n == 1)return arr[0];
        
        dp = new int[n][totalsum + 1];
        for(int[] row : dp){
            Arrays.fill(row , -1);
        }
        return subset(arr,0,0);
    }
}
