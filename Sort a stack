    if(st.isEmpty()){
        return;
    }
    
    int x = st.pop();
    sortStack(st);
    
    insert(x,st);
    }
    private void insert(int x, Stack<Integer> st){
     
    if(st.isEmpty() || x > st.peek()){
        st.push(x);
        return;
    }
    int top = st.pop();
    insert(x,st);
    st.push(top);
    }
