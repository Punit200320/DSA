class Solution {
    static int[][] dp;
    static boolean solve(int[] arr,int i,int tar,int n){
        
        if(tar == 0){
            return true;
        }
        
        if(i >= n || tar < 0){
            return false;
        }
        if(dp[i][tar] != -1){
            return dp[i][tar] == 1;
        }
        boolean take ,skip;
        take = solve(arr,i + 1,tar - arr[i],n);
        skip = solve(arr,i + 1, tar, n);
        
         boolean ans =  take || skip;
        dp[i][tar] = ans ? 1 : 0;
        return ans;
    }
    static boolean equalPartition(int arr[]) {
        // code here
        
        int sum =0;
        int n = arr.length;
        for(int i =0;  i < arr.length; i ++){
            sum = arr[i] + sum;
        }
        if(sum %2 != 0 ){
            return false;
        }
        dp = new  int[n + 1][ (sum /2) +1];
        for(int[] row : dp){
            Arrays.fill(row, -1);
        }
        return solve(arr,0,sum /2,n);
    }
}
