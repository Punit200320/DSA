class Solution {
    public int maxProfit(int[] prices) {
      int n = prices.length;
      int minprices = Integer.MAX_VALUE;
      int maxa = 0;
      for(int price :prices){
        if(minprices >  price){
            minprices = price;
        }else{
            maxa = Math.max(maxa, price - minprices);
        }
      }
      return maxa;
    }
}
