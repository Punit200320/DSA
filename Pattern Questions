class Main {
    public static void main(String[] args) {

        int ans = 4;
        int cap = 5;

        for (int i = 0; i < 5; i++) {

            // Print spaces
            for (int j = 0; j < ans; j++) {
                System.out.print(" ");
            }

            // Print stars
            for (int k = ans; k < cap; k++) {
                System.out.print("*");
            }

            // Move to the next line
            System.out.println();

            ans--;
            cap += 2;
        }
    }
}
