class Solution {

    public void dfs( ArrayList<ArrayList<Integer>> adj,int u,boolean[] visited,int n){
      visited[u] = true;
      for(int v: adj.get(u)){
          if( !visited[v]){
              dfs(adj,v,visited,n);
          }
      }
    }
    int countConnected(int V, ArrayList<ArrayList<Integer>> edges) {
        // code here
     
     ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
     
     for(int i = 0; i < V; i++){
         adj.add(new ArrayList<>());
     }
     for(ArrayList<Integer> edge : edges){
         int u = edge.get(0);
         int v = edge.get(1);
         adj.get(u).add(v);
         adj.get(v).add(u);
     }
     boolean[] visited = new boolean[V];
     int count = 0;
     for(int i = 0; i < V; i++){
         if(!visited[i]){
         count++;
         dfs(adj,i,visited,V);
         }
     }
     return count;
    }
}
