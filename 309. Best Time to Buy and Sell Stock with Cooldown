class Solution {
    int[][] dp;
    private int maxa(int i,int buy1,int[] prices){
    if(i >= prices.length) return 0;
    int ans = 0;
    if(dp[i][buy1] != -1){
        return dp[i][buy1];
    }
    if(buy1 == 0){
    int buy = maxa(i + 1, 1, prices) - prices[i];
    int notbuy = maxa(i + 1, 0,prices);
    ans = Math.max(buy,notbuy);
    }else{
    
      int sell =   maxa(i + 2, 0, prices) + prices[i];
      int notsell = maxa(i + 1, 1, prices);
      ans = Math.max(sell,notsell);
    } 
    return dp[i][buy1] =  ans;
    }
    public int maxProfit(int[] prices) {
       int n = prices.length;
       dp = new int[n +1][2];
       for(int[] row : dp){
        Arrays.fill(row, -1);
       }
       if(n  == 1 || n ==  0) return 0;
       return maxa(0,0,prices); 
    }
}
