class Solution {
    ArrayList<Integer> preOrder(Node root) {
        // code here
        ArrayList<Integer> preorder = new ArrayList<>();
        if(root == null){
            return preorder;
        }
        
        Stack<Node> st = new Stack<>();
        st.push(root);
        
        while(!st.isEmpty()){
            root = st.pop();
            preorder.add(root.data);
            
            if(root.right != null){
                st.push(root.right);
            }
            if(root.left != null){
                st.push(root.left);
            }
        }
        return preorder;
    }
}
