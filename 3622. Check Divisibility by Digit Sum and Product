class Solution {
    public boolean checkDivisibility(int n) {
    ArrayList<Integer> digit = new ArrayList<>();
    // int i =0;
    int temp = n;
    while(temp  > 0){
        int ans = temp % 10;
        digit.add(ans);
        temp = temp /10;
    }
    int sum = 0;
    int product = 1;
    for(int i = 0; i < digit.size(); i++){
        sum = sum + digit.get(i);
        product = product * digit.get(i);
    }
    int  result = sum +product;
    if(n % result == 0){
        return true;
    }
    return false;
    }
}
