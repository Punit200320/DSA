class Solution {
    public boolean  solve(int[] arr,int  n ,int target, int i){
          if(target == 0){
            return true;
          }
          if( target < 0){
            return false;
          }
          if( i > n){
            return false;
          }
          boolean take = solve(arr, n , target - arr[i], i + 1);
          boolean skip = solve(arr, n , target,  i + 1);
          if( take == true || skip == true){
            return true;
          }
          return false;
    }
    public boolean isSubsetSum(int[] arr, int target) {
      int n = arr.length;
      return solve(arr, n -1 , target, 0);
    }
}
