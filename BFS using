class Solution {
    public boolean Bfs(ArrayList<ArrayList<Integer>> edges,int u ,boolean[] visited,int parent){
    //  visited[u] = true;
    //  for(int v: edges.get(u)){
    //      if(v == parent){
    //          continue;
    //      }
    //      if(visited[v]){
    //          return true;
    //      }
    //      if(Dfs(edges,v,visited,u)){
    //          return true;
    //  }
    Queue<int[]> queue = new LinkedList<>();
    queue.offer(new int[]{u, -1});
    visited[u] = true;
    while(!queue.isEmpty()){
        int[] pair = queue.poll();
        int source = pair[0];
        int parents = pair[1];
        for(int v : edges.get(source)){
            if(!visited[v]){
                visited[v] = true;
                queue.offer(new int[]{v,source});
            }else if(v != parents){
                return true;
            }
        }
    }
    return false;
    }
    public boolean isCycle(int V, int[][] edges) {
        // Code here
      ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
      for(int i = 0; i < V; i++){
          adj.add(new ArrayList<>());
      }
      for(int[] edge: edges){
          int u = edge[0];
          int v  = edge[1];
          adj.get(u).add(v);
          adj.get(v).add(u);
      }
      boolean[] visited = new boolean[V];
      for(int i =  0; i < V; i++){
          if(!visited[i] && Bfs(adj,i,visited,-1)){
              return true;
          }
      }
      return false;
    }
}
