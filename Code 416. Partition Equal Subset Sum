class Solution {
    int dp[][];
    public boolean sumsubset(int[] nums,int target,int i){
        if(target == 0) return true;
        if(i >= nums.length || target < 0){
            return false;
        }
        if(dp[i][target] != -1){
            return dp[i][target] == 1;
        }
       
       boolean take = sumsubset(nums, target - nums[i],i + 1);
       boolean skip = sumsubset(nums, target, i + 1);
 
       dp[i][target] = (take || skip) ? 1 :0;

       return take || skip; 
    }
    public boolean canPartition(int[] nums) {
        int sum = 0;
        int n = nums.length;
        for(int i = 0; i < n; i ++){
            sum = sum + nums[i];
        }
        if(sum % 2 != 0){
            return false;
        }
        int target =  sum /2;
        dp = new int[n][target +1];
        
        for(int [] row : dp){
            Arrays.fill(row, -1);
        }
            return sumsubset(nums,target,0);
    }
}
