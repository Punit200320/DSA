class Solution {
    int[][] dp;
    private int solve(int[] nums,int prev,int curr){
    if(curr==  nums.length){
        return 0;
    }  
    if(prev != -1 && dp[prev][curr] != -1) return dp[prev][curr];
    int take = 0;
    if(prev == -1 || nums[curr] > nums[prev]){
        take = 1 + solve(nums,curr, curr +1);
    }
    int nottake = solve(nums,prev, curr + 1);
    if(prev  != -1){
      dp[prev][curr] = Math.max(take,nottake);
    }
    return Math.max(nottake,take);
    }
    public int lengthOfLIS(int[] nums) {
       int n = nums.length;
       dp = new int[2501][2501];
       for(int[] row : dp){
        Arrays.fill(row, -1);
       }
       return solve(nums,-1,0);
    }
}
