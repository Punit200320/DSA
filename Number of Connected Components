class Solution {
    public void bfs(ArrayList<ArrayList<Integer>> adj, int u, boolean[] visited, int n){
        Queue<Integer> que = new LinkedList<>();
        que.add(u);
        visited[u] = true;
        while(!que.isEmpty()){
            int curr = que.poll();
            for(int v : adj.get(curr)){
                if(!visited[v]){
                    visited[v] = true;
                    que.add(v);
                }
            }
        }
    }
    int countConnected(int V, ArrayList<ArrayList<Integer>> edges) {
    ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
    for(int i = 0; i < V; i++){
        adj.add(new ArrayList<>());
    }
    
    for (ArrayList<Integer> edge : edges) {

                int u = edge.get(0);
                int v = edge.get(1);

                adj.get(u).add(v);
                adj.get(v).add(u);
            }
    boolean[] visited = new boolean[V];
    int count = 0;
    for(int i = 0; i < V; i++){
        if(!visited[i]){
            bfs(adj,i ,visited,V);
            count++;
        }
    }
    return count;
    }
}
